<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WorkBuddy" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 状态栏为深色实色，与浅色页面顶栏形成对比（相反色）；
             内容不再延伸到状态栏下方（由 WindowCompat.setDecorFitsSystemWindows(true) 控制），
             避免把软件顶栏染成黑灰色，也避免内容贴到最顶端。 -->
        <item name="android:statusBarColor">#0F1419</item>
        <item name="android:navigationBarColor">#0F1419</item>
    </style>
</resources>
